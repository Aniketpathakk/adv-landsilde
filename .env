# ===================================================================
# GeoRisk Sentinel Environment Variables & Map API Keys Configuration
# ===================================================================

# 1. Google Maps Platform API Key (Optional)
# If you have a Google Cloud Console API Key with "Maps JavaScript API" & "Roads API" enabled:
VITE_GOOGLE_MAPS_API_KEY=

# 2. Mapbox Access Token (Optional)
# If you use Mapbox Studio styles or high-resolution custom terrain:
VITE_MAPBOX_TOKEN=

# 3. IMD (India Meteorological Department) Live API Key & Doppler Radar
VITE_IMD_API_KEY=PUBLIC_GOV_ACCESS
VITE_IMD_API_ENDPOINT=https://api.imd.gov.in/api/v1/
VITE_IMD_DOPPLER_API_ENDPOINT=https://api.open-meteo.com/v1/forecast

# 4. ESA Copernicus / ISRO Sentinel-1 InSAR Pipeline
VITE_COPERNICUS_SENTINEL_API_KEY=copernicus_open_hub_nerdma_v4
VITE_COPERNICUS_INSAR_ENDPOINT=https://dataspace.copernicus.eu/api/sentinel1/insar

# 5. GSI / BRO Physical IoT Sensor MQTT Gateway
VITE_GSI_BRO_IOT_MQTT_BROKER=wss://telemetry.nerdma.gov.in/mqtt
